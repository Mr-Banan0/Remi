[Unit]
Description=Verified Remi database backup
After=remi-test.service

[Service]
Type=oneshot
User=remi-test
Group=remi-test
WorkingDirectory=/opt/remi-test/current
Environment=PYTHONPATH=/opt/remi-test/current/src
ExecStart=/opt/remi-test/current/.venv/bin/python -m remi.cli backup-cycle --path /opt/remi-test/data/remi.sqlite3 --backup-directory /opt/remi-test/backups/automatic
UMask=0077
TimeoutStartSec=120
Nice=10
