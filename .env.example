# Read an existing private environment file through EMBERGRAPH_ENV_FILE if desired.
EMBERGRAPH_BACKEND=sqlite
EMBERGRAPH_DB_PATH=.local-data/embergraph.sqlite3
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.quickrouter.us/v1
# LLM_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBERGRAPH_EMBEDDING_MODEL=text-embedding-v4
EMBERGRAPH_EMBEDDING_DIMENSIONS=1024
# DASHSCOPE_API_KEY=
TYPESAFE_BASE_URL=https://api.quickrouter.ai/v1
TYPESAFE_MODEL=jev-1.13.0
# TYPESAFE_API_KEY=
# TYPESAFE_API_KEY_FILE=/absolute/path/private-jev-key
EMBERGRAPH_ADD_TIMEOUT=180
EMBERGRAPH_LLM_TIMEOUT=45
EMBERGRAPH_SEARCH_TIMEOUT=45
EMBERGRAPH_RERANK_TIMEOUT=8
EMBERGRAPH_HOT_LIMIT=24
EMBERGRAPH_CANDIDATE_LIMIT=40
EMBERGRAPH_GRAPH_LIMIT=12
EMBERGRAPH_DECISION_BYTES=24000
EMBERGRAPH_EVIDENCE_BYTES=6000
EMBERGRAPH_CONTEXT_BYTES=4000
# MEMORY_API_KEY=
