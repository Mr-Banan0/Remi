# Read an existing private environment file through REMI_ENV_FILE if desired.
REMI_BACKEND=sqlite
REMI_DB_PATH=.local-data/remi.sqlite3
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.quickrouter.us/v1
# LLM_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
REMI_EMBEDDING_MODEL=text-embedding-v4
REMI_EMBEDDING_DIMENSIONS=1024
# DASHSCOPE_API_KEY=
TYPESAFE_BASE_URL=https://api.quickrouter.ai/v1
TYPESAFE_MODEL=jev-1.13.0
# TYPESAFE_API_KEY=
# TYPESAFE_API_KEY_FILE=/absolute/path/private-jev-key
REMI_ADD_TIMEOUT=180
REMI_LLM_TIMEOUT=45
REMI_SEARCH_TIMEOUT=45
REMI_RERANK_TIMEOUT=8
REMI_HOT_LIMIT=24
REMI_CANDIDATE_LIMIT=40
REMI_GRAPH_LIMIT=12
REMI_ROLE_RECALL_MIN_SCORE=0.02
REMI_DECISION_BYTES=24000
REMI_EVIDENCE_BYTES=6000
REMI_CONTEXT_BYTES=4000
# MEMORY_API_KEY=
